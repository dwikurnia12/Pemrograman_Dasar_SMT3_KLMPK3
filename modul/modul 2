class Dosen:
    def __init__(self, nama, nidn, mata_kuliah):
        self.nama = nama
        self.nidn = nidn
        self.mata_kuliah = mata_kuliah

    def info(self):
        print(f"Nama Dosen {self.nama}, dengan NIDN {self.nidn} pengampu mata kuliah {self.mata_kuliah}")

    def update_mata_kuliah(self, mk_baru):
        self.mata_kuliah = mk_baru
        print(f"[INFO] Mata kuliah {self.nama} berhasil diubah menjadi: {self.mata_kuliah}")

dosen1 = Dosen("Vearen Dika", "0012345670", "Pemrograman Dasar")
dosen2 = Dosen("Aris Budianto", "00223456700", "Strategi Belajar Mengajar")
dosen3 = Dosen("Slamet Kurniawan", "00323456700", "Keamanan Jaringan Komputer")

print("===TAMPILKAN DATA DOSEN===")
print("\nDosen 1")
dosen1.info()

print("\nDosen 2")
dosen2.info()

print("\nDosen 3")
dosen3.info()

print("\n===UPDATE MATA KULIAH===")
dosen1.update_mata_kuliah("Desain Web")

print("\n===DATA DOSEN UPDATE===")
dosen1.info()

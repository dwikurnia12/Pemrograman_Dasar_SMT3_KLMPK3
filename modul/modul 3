koleksi_lagu = []

def tambah_lagu():
    judul = input("Masukkan judul lagu : ")
    penyanyi = input("Masukkan nama penyanyi : ")

    lagu = {
        "judul": judul,
        "penyanyi": penyanyi
    }

    koleksi_lagu.append(lagu)
    print("Lagu berhasil ditambahkan!\n")

def tampilkan_lagu():
    if len(koleksi_lagu) == 0:
        print("Koleksi lagu masih kosong.\n")
    else:
        print("\n=== DAFTAR KOLEKSI LAGU ===")

        for i, lagu in enumerate(koleksi_lagu, start=1):
            print(f"{i}. {lagu['judul']} - {lagu['penyanyi']}")

        print()

def hapus_lagu():
    judul = input("Masukkan judul lagu yang ingin dihapus :")

    for lagu in koleksi_lagu:
        if lagu ["judul"].lower() == judul.lower():
            koleksi_lagu.remove(lagu)
            print("Lagu berhasil dihapus!")
            return

    print("Lagu tidak ditemukan...")

def cari_lagu():
    penyanyi = input("Masukkan nama penyanyi yang dicari : ")
    ditemukan = False

    print(f"\n=== HASIL PENCARIAN PENYANYI: {penyanyi.upper()} ===")
    for lagu in koleksi_lagu:
        if penyanyi.lower() in lagu["penyanyi"].lower():
            print(f"- {lagu['judul']} ({lagu['penyanyi']})")
            ditemukan = True

    if not ditemukan:
        print("Lagu dari penyanyi tersebut tidak ditemukan.")
    print()

def main():
    while True:
        print("=== MENU MANAJEMEN KOLEKSI LAGU ===")
        print("1. Tambah Lagu")
        print("2. Tampilkan Semua Lagu")
        print("3. Hapus Lagu")
        print("4. Cari Lagu (Penyanyi)")
        print("5. Keluar")
        
        pilihan = input("Pilih menu (1-5): ")
        print()

        if pilihan == "1":
            tambah_lagu()
        elif pilihan == "2":
            tampilkan_lagu()
        elif pilihan == "3":
            hapus_lagu()
        elif pilihan == "4":
            cari_lagu()
        elif pilihan == "5":
            print("Terima kasih, program selesai!")
            break
        else:
            print("Pilihan tidak valid! Silakan pilih menu 1-5.\n")

main()